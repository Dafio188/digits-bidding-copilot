{
    "name": "digits-bidding-copilot",
    "version": "1.0.0",
    "description": "MEPA & Consip Bidding Co-Pilot per DIGITS DISTRIBUZIONE SRL",
    "main": "dist/server.mjs",
    "type": "module",
    "scripts": {
        "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "tsx watch server.ts",
        "dev:client": "vite",
        "build": "npm run build:client && npm run build:server",
        "build:client": "vite build",
        "build:server": "esbuild server.ts --bundle --platform=node --outfile=dist/server.mjs --format=esm --packages=external",
        "start": "node dist/server.mjs",
        "download:historical": "tsx scripts/download_historical.ts",
        "job:daily": "ts-node --esm --project tsconfig.server.json -e \"import('./ingestion.js').then(m => m.dailyIncrementalJob())\"",
        "db:migrate": "ts-node --esm scripts/migrate.ts",
        "db:seed": "ts-node --esm scripts/seed.ts",
        "import:anac": "tsx scripts/import_anac_files.ts"
    },
    "dependencies": {
        "@google/genai": "latest",
        "@types/better-sqlite3": "^7.6.13",
        "@types/multer": "^2.2.0",
        "@types/pdf-parse": "^1.1.5",
        "@types/pg": "^8.20.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "csv-parse": "^7.0.1",
        "docx": "^8.5.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "framer-motion": "^11.1.7",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^0.378.0",
        "multer": "^2.2.0",
        "node-cron": "^3.0.3",
        "pdf-parse": "^2.4.5",
        "pg": "^8.22.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.12.7",
        "@types/node-cron": "^3.0.11",
        "@types/react": "^18.3.1",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.19",
        "concurrently": "^8.2.2",
        "esbuild": "^0.20.2",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.3",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.0",
        "typescript": "^5.4.5",
        "vite": "^5.2.10"
    }
}
